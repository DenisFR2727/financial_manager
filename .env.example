# Atlas → Connect → Drivers → copy connection string (mongodb+srv://)
# On Windows the app uses public DNS (8.8.8.8) for SRV lookup — do not use standard mongodb:// URI.
MONGODB_URI=mongodb+srv://<user>:<password>@clusters.xxxxx.mongodb.net/financial_manager?retryWrites=true&w=majority

PORT=3001
CLIENT_URL=http://localhost:5173

# Vercel (client) — Render backend URL without trailing slash
# VITE_API_URL=https://financial-manager-pj9z.onrender.com
